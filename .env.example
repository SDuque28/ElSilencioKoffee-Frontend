# Frontend public runtime configuration example
# Copy this file to .env in the frontend project root before running npm scripts.
# These values are public client-side config and must not contain secrets.
# Local development can keep the proxy-based /api-auth values below.
# Production platforms like Vercel should set NG_APP_API_URL and
# NG_APP_AUTH_API_URL to the deployed backend URL instead of relying on /api-auth.

NG_APP_API_URL=/api-auth
NG_APP_AUTH_API_URL=/api-auth
NG_APP_IS_MOCK_MODE=false
NG_APP_DEBUG_API_LOGGING=false
