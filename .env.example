# Frontend public runtime configuration example
# Copy this file to .env in the frontend project root before running npm scripts.
# These values are public client-side config and must not contain secrets.

NG_APP_API_URL=https://elsilenciokofee.com/api/v1
NG_APP_AUTH_API_URL=/api-auth
NG_APP_IS_MOCK_MODE=true
NG_APP_DEBUG_API_LOGGING=true
