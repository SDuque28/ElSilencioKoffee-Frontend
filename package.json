{
  "name": "el-silencio-koffee-frontend",
  "version": "0.0.0",
  "scripts": {
    "prepare:runtime-env": "node scripts/generate-runtime-env.mjs",
    "ng": "ng",
    "start": "npm run prepare:runtime-env && ng serve",
    "start:e2e": "npm run prepare:runtime-env && ng serve --host 127.0.0.1 --port 4200",
    "build": "npm run prepare:runtime-env && ng build",
    "watch": "npm run prepare:runtime-env && ng build --watch --configuration development",
    "test": "npm run prepare:runtime-env && ng test",
    "cy:open": "node scripts/run-cypress.mjs open",
    "cy:run": "node scripts/run-cypress.mjs run",
    "cy:run:smoke": "node scripts/run-cypress.mjs run --spec cypress/e2e/smoke/**/*.cy.ts",
    "e2e": "start-server-and-test start:e2e http://127.0.0.1:4200 cy:run",
    "e2e:smoke": "start-server-and-test start:e2e http://127.0.0.1:4200 cy:run:smoke",
    "e2e:open": "start-server-and-test start:e2e http://127.0.0.1:4200 cy:open",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-angular": "^0.577.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.0",
    "@angular-eslint/eslint-plugin": "^21.3.0",
    "@angular-eslint/eslint-plugin-template": "^21.3.0",
    "@angular-eslint/template-parser": "^21.3.0",
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.27",
    "cypress": "^15.13.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
